{
  "name": "sparkbroadcastcg",
  "version": "1.0.0",
  "private": true,
  "description": "Broadcast character generator: control page + CG render page.",
  "workspaces": [
    "server",
    "control",
    "cg"
  ],
  "scripts": {
    "dev": "concurrently -n SERVER,CONTROL,CG \"npm run dev -w server\" \"npm run dev -w control\" \"npm run dev -w cg\"",
    "build": "tsc && npm run build -w control -w cg",
    "typecheck": "tsc",
    "lint": "eslint .",
    "test": "npm test -w server"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "concurrently": "^10.0.5"
  },
  "type": "module",
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
